{% doc %}
  @prompt
    ホームページトップに設置する告知バナー, リンクのテキストはメッセージの次に改行して表示したい。, リンクテキストの隣の矢印は不要。, メッセージは改行もできるように。
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-announcement-{{ ai_gen_id }} { display:block; width:{{ block.settings.desktop_width_percent }}%; max-width:100%; margin-inline:auto; padding:{{ block.settings.padding_vertical }}px 24px; box-sizing:border-box; background:{{ block.settings.background_color }}; color:{{ block.settings.text_color }}; text-align:center; font-family:inherit; }
  .ai-announcement-{{ ai_gen_id }}__inner { display:flex; width:100%; max-width:1200px; flex-direction:column; align-items:center; justify-content:center; gap:6px; margin-inline:auto; }
  .ai-announcement-{{ ai_gen_id }}__message { margin:0; font-size:{{ block.settings.text_size }}px; line-height:1.6; white-space:pre-line; }
  .ai-announcement-{{ ai_gen_id }}__link { display:inline-flex; align-items:center; color:{{ block.settings.text_color }}; font-size:{{ block.settings.text_size }}px; line-height:1.6; font-weight:600; text-decoration:underline; text-underline-offset:3px; }
  .ai-announcement-{{ ai_gen_id }}__link:focus-visible { outline:2px solid currentColor; outline-offset:4px; border-radius:2px; }
  @media screen and (max-width:749px) { .ai-announcement-{{ ai_gen_id }} { width:100%; padding-inline:16px; } }
{% endstyle %}
<div class="ai-announcement-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-announcement-{{ ai_gen_id }}__inner">
    {% if block.settings.message != blank %}<p class="ai-announcement-{{ ai_gen_id }}__message">{{ block.settings.message | escape }}</p>{% endif %}
    {% if block.settings.link_label != blank and block.settings.link_url != blank %}<a class="ai-announcement-{{ ai_gen_id }}__link" href="{{ block.settings.link_url }}">{{ block.settings.link_label | escape }}</a>{% endif %}
  </div>
</div>
{% schema %}
{
  "name":"告知バナー",
  "settings":[
    {"type":"header","content":"告知内容"},
    {"type":"textarea","id":"message","label":"メッセージ","default":"新着情報やお知らせをこちらに表示します"},
    {"type":"text","id":"link_label","label":"リンクのテキスト","default":"詳しく見る"},
    {"type":"url","id":"link_url","label":"リンク先"},
    {"type":"header","content":"デザイン"},
    {"type":"range","id":"desktop_width_percent","label":"デスクトップ幅","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"range","id":"padding_vertical","label":"上下の余白","min":8,"max":40,"step":2,"unit":"px","default":16},
    {"type":"range","id":"text_size","label":"文字サイズ","min":12,"max":24,"step":1,"unit":"px","default":16},
    {"type":"color","id":"background_color","label":"背景色","default":"#1F1F1F"},
    {"type":"color","id":"text_color","label":"文字色","default":"#FFFFFF"}
  ],
  "presets":[{"name":"告知バナー"}],
  "tag":null,
  "class":"announcement-banner-block"
}
{% endschema %}